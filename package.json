{
  "name": "@quartermint/v2cf",
  "version": "0.1.0",
  "description": "Convert Vercel Next.js projects to Cloudflare",
  "type": "module",
  "bin": {
    "v2cf": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "consola": "^3.4.2",
    "execa": "^9.6.1",
    "ts-morph": "^27.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/deep-diff": "^1.0.5",
    "@types/node": "^22",
    "@types/pngjs": "^6.0.5",
    "deep-diff": "^1.0.2",
    "diff2html": "^3.4.56",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
